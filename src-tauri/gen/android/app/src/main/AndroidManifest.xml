<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- mDNS is multicast, and Android drops multicast to the app layer unless
         the process holds a multicast lock. Without this, LANTern can be seen
         by other devices but cannot see them. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Voice, video and screen sharing capture on this device. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Peers stay reachable while the app is backgrounded during a call. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!--
         Not dataSync. That type reads right - "keeps talking to something
         over the network on the user's behalf" - and it crashed the app for
         it: Android 14 caps a dataSync foreground service at roughly six
         hours in a rolling day and then kills it outright, which for a
         service whose entire job is to run indefinitely is not a limit, it
         is a countdown. specialUse carries no such cap; it exists for
         exactly a service that does not fit the other typed buckets and
         means to keep running. See the service declaration below for the
         reason string Android requires alongside it.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The foreground service above keeps LANTern reachable while
         backgrounded, but Android's battery optimizer can still doze the
         process and drop it off the network between wakeups. This permission
         only allows asking to be exempted - the system dialog it opens is
         the actual grant, and it can be refused. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Handing a downloaded APK to the system package installer. Android
         still asks the user to approve both the permission and the install;
         this only allows the app to make the request. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <!-- A television has no touchscreen, and the Play Store hides any app that
         does not say so from TV devices entirely. Declaring it optional is what
         makes this installable there. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:theme="@style/Theme.lantern"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true"
            android:label="${appLabel}"
            android:name=".MainActivity"
            android:banner="@drawable/tv_banner"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".LanternService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <!-- Required by Android 14+ for any specialUse foreground
                 service - a free-text reason, reviewed only if this ever
                 goes through the Play Store, which a sideloaded LAN app
                 does not. -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Stays reachable to other devices on the local network while not on screen" />
        </service>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
