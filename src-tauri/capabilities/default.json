{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions the LANTern window needs. Tauri's IPC is deny-by-default, so without this the frontend cannot subscribe to events or reach any plugin - and startup silently does nothing.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-unminimize",
    "core:window:allow-set-focus",
    "opener:default",
    "shell:allow-open",
    "clipboard-manager:default",
    "dialog:default",
    "fs:default",
    "notification:default",
    "os:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://api.github.com/*"
        },
        {
          "url": "https://github.com/*"
        },
        {
          "url": "https://objects.githubusercontent.com/*"
        },
        {
          "url": "https://release-assets.githubusercontent.com/*"
        }
      ]
    }
  ]
}
